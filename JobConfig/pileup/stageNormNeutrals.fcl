#
# Opt-in: record stage normalization on the Neutrals pileup stage.
# Include AFTER pileup/NeutralsResampler.fcl.
#
# Applied per stage rather than on the shared resampler definition: the same
# filter serves several stages against different pools, so the pool's counter
# label is a property of the STAGE, not of the resampler.
#
# The pool must carry "neutralsCounter". For a pool predating this workflow, replace the
# stageNormMixer block with the pool's stated totals:
#   poolGenCount : <GenEventCount total over fileNames>
#   poolEventCount : <events over fileNames>
#
# This stage uses neutralsResampler, not beamResampler, so its counters name
# that filter and the pool is the Neutrals stream written by the POT stage.
physics.filters.neutralsResampler.mu2e.products.stageNormMixer : {
  moduleLabel   : "neutralsCounter"      # written by beam/stageNorm.fcl
  srOutInstance : "resampled"
}
physics.producers.flashCounter      : @local::Pileup.producers.neutralsFlashCounter
physics.producers.earlyFlashCounter : @local::Pileup.producers.neutralsEarlyFlashCounter
physics.flashPath      : [ @sequence::physics.flashPath,      flashCounter ]
physics.earlyFlashPath : [ @sequence::physics.earlyFlashPath, earlyFlashCounter ]
