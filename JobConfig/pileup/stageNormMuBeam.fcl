#
# Opt-in: record stage normalization on the MuBeam pileup stage.
# Include AFTER Production/JobConfig/pileup/MuBeamResampler.fcl.
#
# This is a RESAMPLING stage: the job's source is EmptyEvent, so its own
# GenEventCount counts DRAWS, and the resampled pool arrives as a mixing
# secondary whose SubRun products never reach the output. The mixer therefore
# carries the pool's normalization through, scaled by the draw count, and each
# stream's counter reports its own passed count against it.
#
# It is applied HERE rather than to the shared `beamResampler` definition in
# the pileup prolog, because EleBeamResampler and PiBeamResampler use that same
# definition against entirely different pools -- muonCounter is not their
# label, and configuring it there aborts them on the first event.
#
# The pool must carry muonCounter, i.e. be built by BeamSplitter with
# stageNormSplitter.fcl. For a MuBeamCat predating this workflow, replace the
# block below with the pool's stated totals (see the note in the prolog):
#
#   physics.filters.beamResampler.mu2e.products.stageNormMixer: {
#     poolGenCount    : <GenEventCount total over ALL of fileNames>
#     poolEventCount  : <events in ALL of fileNames>
#     srOutInstance   : "resampled"
#   }
#
physics.filters.beamResampler.mu2e.products.stageNormMixer : {
  moduleLabel   : "muonCounter"
  srOutInstance : "resampled"
}

physics.producers.targetStopCounter : @local::Pileup.producers.targetStopCounter
physics.producers.polyStopCounter   : @local::Pileup.producers.polyStopCounter
physics.producers.IPAStopCounter    : @local::Pileup.producers.IPAStopCounter
physics.producers.flashCounter      : @local::Pileup.producers.flashCounter
physics.producers.earlyFlashCounter : @local::Pileup.producers.earlyFlashCounter

physics.targetStopPath : [ @sequence::physics.targetStopPath, targetStopCounter ]
physics.polyStopPath   : [ @sequence::physics.polyStopPath,   polyStopCounter ]
physics.IPAStopPath    : [ @sequence::physics.IPAStopPath,    IPAStopCounter ]
physics.flashPath      : [ @sequence::physics.flashPath,      flashCounter ]
physics.earlyFlashPath : [ @sequence::physics.earlyFlashPath, earlyFlashCounter ]
