#
# Prolog to create pileup particle steps for mixing
#
#include "Offline/TrackerMC/fcl/prolog.fcl"
#include "Offline/CaloMC/fcl/prolog.fcl"
#include "Offline/CRVResponse/fcl/prolog.fcl"
#include "Offline/Filters/fcl/prolog.fcl"
#include "Offline/Compression/fcl/prolog.fcl"
#include "Offline/fcl/standardServices.fcl"
#
BEGIN_PROLOG

STMPileup: {
  producers : {
    protonTimeOffset : @local::CommonMC.protonTimeOffset

    # Shared VDResamplerGenerateMix configuration, used by VDResamplerGenerateMix.fcl (standalone
    # generation and sample dump) and VDResamplerToCrystals.fcl (generation followed by
    # propagation to the STM crystals). Override individual members in the including file where
    # they need to differ.
    VDResamplerGenerator : {
      module_type : VDResamplerGenerateMix
      hitSummaryFiles : [
        "root://fndcadoor.fnal.gov:1094/mu2e/resilient/users/yongyiwu/STMVDResampler/MDC2025ai/etc.mu2e.STMVDResamplerConfigure_VD116_hitSummary.MDC2025ai.001430_00000000.txt", # EleBeam
        "root://fndcadoor.fnal.gov:1094/mu2e/resilient/users/yongyiwu/STMVDResampler/MDC2025ai/etc.mu2e.STMVDResamplerConfigure_VD116_hitSummary.MDC2025ai.001430_00000001.txt", # MuBeam
        "root://fndcadoor.fnal.gov:1094/mu2e/resilient/users/yongyiwu/STMVDResampler/MDC2025ai/etc.mu2e.STMVDResamplerConfigure_VD116_hitSummary.MDC2025ai.001430_00000002.txt", # TargetStops1809
        "root://fndcadoor.fnal.gov:1094/mu2e/resilient/users/yongyiwu/STMVDResampler/MDC2025ai/etc.mu2e.STMVDResamplerConfigure_VD116_hitSummary.MDC2025ai.001430_00000003.txt"  # Neutrals
      ] # requiring a list
      potsPerFile : [ # <number of simulated events> / <number of output from last stage> * <POT of the last stage>
        98360017778.32725, # dts.mu2e.STMBeamToVDEle116.MDC2025ai.art    : 5441845688 / 5532579  * 1e8
        467691847195.7197, # dts.mu2e.STMBeamToVDMu116.MDC2025ai.art     : 1e9        / 213816   * 1e8
        5186958594225.648, # dts.mu2e.STM1809ToVD116.MDC2025au.art       : 4e9     / 1442670/1e3 * 4e9 / 213816  * 1e8
        3743491962.619810  # dts.mu2e.STMNeutralsToVD116Cat.MDC2025av.art: 2000000000 / 53426053 * 1e8
      ] # list of corresponding POTs
      # ModelFileDir is now overridden by ModelFileList
      ModelFileList : "root://fndcadoor.fnal.gov:1094/mu2e/resilient/users/yongyiwu/STMVDResampler/MDC2025ai/etc.mu2e.STMVDResamplerModels_VD116_catalog.MDC2025ai.001430_00000000.txt" # path to a .txt catalog listing one model-file path per line
      resamplerSourceRootFiles : [
        "root://fndcadoor.fnal.gov:1094/mu2e/resilient/users/yongyiwu/STMVDResampler/MDC2025ai/nts.yongyiwu.STMVDResamplerConfigure_VD116_hitDump.MDC2025ai.001430_00000000.root", # EleBeam
        "root://fndcadoor.fnal.gov:1094/mu2e/resilient/users/yongyiwu/STMVDResampler/MDC2025ai/nts.yongyiwu.STMVDResamplerConfigure_VD116_hitDump.MDC2025ai.001430_00000001.root", # MuBeam
        "root://fndcadoor.fnal.gov:1094/mu2e/resilient/users/yongyiwu/STMVDResampler/MDC2025ai/nts.yongyiwu.STMVDResamplerConfigure_VD116_hitDump.MDC2025ai.001430_00000002.root", # TargetStops1809
        "root://fndcadoor.fnal.gov:1094/mu2e/resilient/users/yongyiwu/STMVDResampler/MDC2025ai/nts.yongyiwu.STMVDResamplerConfigure_VD116_hitDump.MDC2025ai.001430_00000003.root"  # Neutrals
      ] # list of root files containing raw data, same order as hitSummaryFiles. needed for SBDMstage1Method != DIFFUSION, specified in hitSummaryFiles
      # resamplerSourceTreeNames : "VDResamplerTrainingSetup/ttree" # default
      # useSummaryFile : [true, true, true, true] # optional, default to all true, if false, the corresponding hitSummaryFiles entry will be skipped
      useHeun : true
      useSDE : true
      sdeToOdeSigmaThreshold : 0.1
      useEMANetworkIfAvailable : true
      diffusionSteps : 500
      # VirtualDetectorID : 116 # only change when another VD is used
      # VDz0 : 37700.39 # z-coordinates of VD116. Only change when another VD is used
      # VDr : 2000.0 # radius of VD116. Only change when another VD is used
      doROOTDump : true
      doValidationPlots : true # requires a resamplerSourceRootFiles entry for every source
    }
  }

  filters : {
    stmResampler: {
      module_type: ResamplingMixer
      fileNames: @nil
      readMode: "sequential" # randomNoReplace
      wrapFiles: true
      mu2e: {
        writeEventIDs : true
        MaxEventsToSkip: @nil
        debugLevel : 1
        products: {
          genParticleMixer: { mixingMap: [ [ "compressDetStepMCsSTM", "" ] ] }
          simParticleMixer: { mixingMap: [ [ "compressDetStepMCsSTM", "" ] ] }
          stepPointMCMixer: { mixingMap: [ [ "compressDetStepMCsSTM:", ":" ] ] } # virtualdetector
          simTimeOffset : "protonTimeOffset"
          volumeInfoMixer: {
            srInput: "g4run"
            evtOutInstanceName: "eventlevel"
          }
        }
      }
    }
  }

  BeamToVDKeptProducts : [
    "keep art::EventIDs_*_*_*",
    "keep mu2e::GenParticles_*_*_*",
    "keep mu2e::GenEventCount_*_*_*", 
    "keep mu2e::StepPointMCs_compressDetStepMCsSTM*_*_*",
    "keep mu2e::SimParticlemv_compressDetStepMCsSTM*_*_*",
    "keep mu2e::SimTimeOffset_*_*_*",
    "keep mu2e::PhysicalVolumeInfomvs_g4run_*_*",
    "keep mu2e::StatusG4_*_*_*"
  ]
  # define some common sequences
  stmResamplerSequence : [genCounter, protonTimeOffset, stmResampler]

  VDResamplerSource : {
    module_type : RootInput
    fileNames: @nil
  }

  VDResamplerServices : {
    message : @local::default_message
    GlobalConstantsService : {
      inputFile : "Offline/GlobalConstantsService/data/globalConstants_01.txt"
    }
  }

  VDResamplerGenSource : {
    module_type : EmptyEvent
    maxEvents : @nil
  }

  VDResamplerGenServices : {
    @table::Services.Sim
    TimeTracker: {
      printSummary: true  # default
    }
  }

}

END_PROLOG