# Propagate the Score-Based Diffusion Model samples from the VD resampler to the STM crystals.
#
# Stage 2 of 2. VDResamplerGenerateMix.fcl generates the GenParticles on the VD116 surface and
# writes them to an art file; this job reads that file, tracks them through the full geometry
# with Mu2eG4 and writes out the compressed STMDet and virtual detector steps. Making the ROOT
# trees from those steps is a separate step again - run Offline/STMMC/fcl/MakeTree.fcl over the
# art files this job produces.
#
# The G4 stage is shared, then the job branches into four independent paths, each with its own
# extraction, compression and filter so that only events reaching that surface are kept on that
# path:
#   STMCrystalPath - STMDet steps, i.e. events depositing energy in the crystals
#   STMVD101Path   - VD101 crossings, directly comparable to the stage 1 resampler samples
#   STMVD89Path    - VD89 (STM_Det1UpStr) crossings, the LaBr front face
#   STMVD90Path    - VD90 (STM_Det2UpStr) crossings, the HPGe front face
# Filters only act on the path they sit on. Outputs pick their path with SelectEvents, so each
# file holds only the events that passed its own filter.
#
# Structure follows BeamToVD.fcl / NeutralsTo2VD.fcl (VD extraction, compression, filtering) and
# STMResampler.fcl (STMDet compression).

# Offline includes
# ------------------------------------------------------------------------------------------------
# Nothing is used from here. Kept for consistency with BeamToVD.fcl and STMResampler.fcl, which
# take CommonMC.protonTimeOffset for their resampler sequences - this job reads pre-generated
# primaries, so it has no resampler and no time offset. Production/JobConfig/pileup/prolog.fcl
# pulls this in transitively anyway.
#include "Offline/CommonMC/fcl/prolog.fcl"
# ------------------------------------------------------------------------------------------------
# The STM specific tags and geometry, <actual value> -> <used element name>:
#   "g4run:virtualdetector"  -> extractVirtualDetectorSteps101.StepPointMCsTag (via the template)
#   101                      -> extractVirtualDetectorSteps101.VirtualDetectorID
#   "compressDetStepMCsSTM"  -> filterVirtualDetectorSteps101.StepPointMCsTag
#   "g4run:virtualdetector"  -> countVirtualDetectorHits.stepPointMCsTag
#include "Offline/STMMC/fcl/prolog.fcl"
# ------------------------------------------------------------------------------------------------
# Services.Sim = Services.Core + Services.SimOnly, <actual value> -> <used element name>:
#   default_message                                              -> services.message
#   "Offline/Mu2eG4/geom/geom_common.txt"                        -> services.GeometryService.inputFile
#   "Offline/GlobalConstantsService/data/globalConstants_01.txt" -> services.GlobalConstantsService.inputFile
#   DbEmpty, Proditions                                          -> services.DbService, services.ProditionsService
#   "MixMaxRng"                                                  -> services.RandomNumberGenerator.defaultEngineKind
#   automaticSeeds                                               -> services.SeedService, overridden by baseSeed : 8 below
#   {}                                                           -> services.Mu2eG4Helper
# TFileService is deliberately absent - this job writes art files only, see the header.
#include "Offline/fcl/standardServices.fcl"

# Production includes
# ------------------------------------------------------------------------------------------------
# <actual value> -> <used element name>:
#   mu2eg4runDefaultSingleStage    -> physics.producers.g4run, target of the g4run overrides below
#   {module_type: GenEventCounter} -> physics.producers.genCounter, unused here (the counts come
#                                     in with the input file) but harmless as part of the table
#   FilterStatusG4 on "g4run", maxAcceptedStatus 9
#                                  -> physics.filters.g4consistentFilter
#   {module_type: GenEventCountReader, makeHistograms: false}
#                                  -> physics.analyzers.genCountLogger. makeHistograms must stay
#                                     false: it would otherwise want TFileService at endJob.
#   [g4run, g4consistentFilter]    -> Common.g4Sequence, the prefix shared by all four paths
# Also brings in Offline/Mu2eG4/fcl/prolog.fcl, which the physics.producers.g4run.* lines act on.
#include "Production/JobConfig/common/prolog.fcl"
# ------------------------------------------------------------------------------------------------
# Nothing is used from here - Pileup.* covers resampling, and this job reads pre-generated
# primaries. The include stays because Production/JobConfig/pileup/epilog.fcl, at the bottom of
# this file, depends on it.
#include "Production/JobConfig/pileup/prolog.fcl"
# ------------------------------------------------------------------------------------------------
# <actual value> -> <used element name>:
#   {module_type: RootInput, fileNames: @nil}          -> source, the stage 1 art files
#   STMPileup.extractVirtualDetectorStepsTemplate      -> the three extractVirtualDetectorSteps*
#   STMPileup.compressDetStepMCsSTMTemplate            -> the three compressDetStepMCsSTM*
# The rest of STMPileup (producers, stmResampler, BeamToVDKeptProducts, VDResamplerGenServices) is
# unused - this job needs the full G4 service stack, so it takes Services.Sim.
#include "Production/JobConfig/pileup/STM/prolog.fcl"

process_name: STMVDResamplerToCrystals

# Reads the GenParticles written by VDResamplerGenerateMix.fcl. Supply the file list with -S, or
# set source.fileNames here.
source : @local::STMPileup.VDResamplerSource

services : @local::Services.Sim

physics : {
  producers : {
    @table::Common.producers # g4run, genCounter
    compressSTMDet : { # Keeps only the wanted StepPoints and SimParticles for this study
      # Creates "mu2e::SimParticlemv_compressSTMDet__STMVDResamplerToCrystals" and
      # "mu2e::StepPointMCs_compressSTMDet_*_STMVDResamplerToCrystals" products from the g4run output
      module_type : CompressDetStepMCs
      strawGasStepTag : ""
      caloShowerStepTag : ""
      surfaceStepTag : ""
      crvStepTag : ""
      simParticleTags : [ "g4run" ]
      debugLevel : 0
      stepPointMCTags : [ "g4run:STMDet", "g4run:virtualdetector" ]
      compressionOptions : {
        strawGasStepCompressionLevel : "noCompression"
        caloShowerStepCompressionLevel : "noCompression"
        crvStepCompressionLevel : "noCompression"
        surfaceStepCompressionLevel : "noCompression"
        stepPointMCCompressionLevel : "noCompression"
        simParticleCompressionLevel : "noCompression"
        keepNGenerations : -1
        mcTrajectoryCompressionLevel : "noCompression"
      }
      mcTrajectoryTag : ""
    }
    # One extraction + compression chain per virtual detector, all cloned from the shared
    # templates in Production/JobConfig/pileup/STM/prolog.fcl. The per-VD differences
    # (VirtualDetectorID, stepPointMCTags) are applied after this physics block closes - FHiCL
    # does not formally support @local:: references into a table that is still being defined,
    # so the chains cannot be cloned from each other here.
    # VD101
    extractVirtualDetectorSteps101 : @local::STMPileup.extractVirtualDetectorStepsTemplate
    compressDetStepMCsSTM : @local::STMPileup.compressDetStepMCsSTMTemplate
    # VD89 - STM_Det1UpStr, the LaBr front face
    extractVirtualDetectorSteps89 : @local::STMPileup.extractVirtualDetectorStepsTemplate
    compressDetStepMCsSTM89 : @local::STMPileup.compressDetStepMCsSTMTemplate
    # VD90 - STM_Det2UpStr, the HPGe front face
    extractVirtualDetectorSteps90 : @local::STMPileup.extractVirtualDetectorStepsTemplate
    compressDetStepMCsSTM90 : @local::STMPileup.compressDetStepMCsSTMTemplate
  }
  filters : {
    @table::Common.filters # g4consistentFilter
    filterSTMDetSteps : {
      # Only keep events that actually deposit energy in the STM crystals.
      # STMDet steps are produced for both the HPGe and LaBr crystals.
      module_type : STMResamplingFilter
      StepPointMCsTag : "compressSTMDet:STMDet"
    }
    filterVirtualDetectorSteps101 : {
      # Only keep events that cross VD101 - extractVirtualDetectorSteps101 creates a collection
      # even when it is empty, so this is required
      module_type : STMResamplingFilter
      StepPointMCsTag : @local::ResamplingFilter.StepPointMCsTag # compressDetStepMCsSTM
    }
    filterVirtualDetectorSteps89 : {
      module_type : STMResamplingFilter
      StepPointMCsTag : "compressDetStepMCsSTM89"
    }
    filterVirtualDetectorSteps90 : {
      module_type : STMResamplingFilter
      StepPointMCsTag : "compressDetStepMCsSTM90"
    }
  }
  analyzers : {
    @table::Common.analyzers # genCountLogger
    countVirtualDetectorHits : {
      # Runs a counter over the virtual detectors to keep track of hits
      module_type : CountVirtualDetectorHits
      stepPointMCsTag : @local::VirtualDetectorCounter.StepPointMCsTag
      virtualDetectorIDs : [88, 89, 90, 100, 101, 116]
    }
  }
  # setup paths - the G4 stage is shared, each path then applies its own filter
  STMCrystalPath : [@sequence::Common.g4Sequence, compressSTMDet, filterSTMDetSteps]
  STMVD101Path : [@sequence::Common.g4Sequence, extractVirtualDetectorSteps101, compressDetStepMCsSTM, filterVirtualDetectorSteps101]
  STMVD89Path : [@sequence::Common.g4Sequence, extractVirtualDetectorSteps89, compressDetStepMCsSTM89, filterVirtualDetectorSteps89]
  STMVD90Path : [@sequence::Common.g4Sequence, extractVirtualDetectorSteps90, compressDetStepMCsSTM90, filterVirtualDetectorSteps90]
  trigger_paths : [STMCrystalPath, STMVD101Path, STMVD89Path, STMVD90Path]
  outPathCompressed : [genCountLogger, countVirtualDetectorHits, crystalOutput, VD101Output, VD89Output, VD90Output]
  end_paths : [outPathCompressed]
}

# Per-VD settings for the three chains cloned from the prolog templates above. These are applied
# at top level, after the physics block has closed, which is the form FHiCL formally supports.
# VD101 matches the template defaults but is set explicitly so all three chains read the same way.
physics.producers.extractVirtualDetectorSteps101.VirtualDetectorID : 101
physics.producers.extractVirtualDetectorSteps89.VirtualDetectorID : 89
physics.producers.extractVirtualDetectorSteps90.VirtualDetectorID : 90
physics.producers.compressDetStepMCsSTM.stepPointMCTags : ["extractVirtualDetectorSteps101"]
physics.producers.compressDetStepMCsSTM89.stepPointMCTags : ["extractVirtualDetectorSteps89"]
physics.producers.compressDetStepMCsSTM90.stepPointMCTags : ["extractVirtualDetectorSteps90"]

# Keep only the necessary data. The GenParticles are carried through from the input file so the
# downstream trees can be traced back to the generated sample.
outputs : {
  crystalOutput : {
    module_type : RootOutput
    outputCommands : [
      "drop *_*_*_*",
      "keep mu2e::GenEventCount_*_*_*",
      "keep art::EventIDs_*_*_*",
      "keep mu2e::GenParticles_*_*_*",
      "keep mu2e::StepPointMCs_compressSTMDet_*_STMVDResamplerToCrystals",
      "keep mu2e::SimParticlemv_compressSTMDet_*_STMVDResamplerToCrystals",
      "keep mu2e::PhysicalVolumeInfomvs_*_*_*",
      "keep mu2e::StatusG4_*_*_*"
    ]
    SelectEvents : [STMCrystalPath]
    fileName : "dts.owner.STMVDResamplerToCrystals.version.sequencer.art"
  }
  VD101Output : {
    module_type : RootOutput
    outputCommands : [
      "drop *_*_*_*",
      "keep mu2e::GenEventCount_*_*_*",
      "keep art::EventIDs_*_*_*",
      "keep mu2e::GenParticles_*_*_*",
      "keep mu2e::StepPointMCs_compressDetStepMCsSTM_*_STMVDResamplerToCrystals",
      "keep mu2e::SimParticlemv_compressDetStepMCsSTM_*_STMVDResamplerToCrystals",
      "keep mu2e::PhysicalVolumeInfomvs_*_*_*",
      "keep mu2e::StatusG4_*_*_*"
    ]
    SelectEvents : [STMVD101Path]
    fileName : "dts.owner.STMVDResamplerToVD101.version.sequencer.art"
  }
  VD89Output : {
    module_type : RootOutput
    outputCommands : [
      "drop *_*_*_*",
      "keep mu2e::GenEventCount_*_*_*",
      "keep art::EventIDs_*_*_*",
      "keep mu2e::GenParticles_*_*_*",
      "keep mu2e::StepPointMCs_compressDetStepMCsSTM89_*_STMVDResamplerToCrystals",
      "keep mu2e::SimParticlemv_compressDetStepMCsSTM89_*_STMVDResamplerToCrystals",
      "keep mu2e::PhysicalVolumeInfomvs_*_*_*",
      "keep mu2e::StatusG4_*_*_*"
    ]
    SelectEvents : [STMVD89Path]
    fileName : "dts.owner.STMVDResamplerToVD89.version.sequencer.art"
  }
  VD90Output : {
    module_type : RootOutput
    outputCommands : [
      "drop *_*_*_*",
      "keep mu2e::GenEventCount_*_*_*",
      "keep art::EventIDs_*_*_*",
      "keep mu2e::GenParticles_*_*_*",
      "keep mu2e::StepPointMCs_compressDetStepMCsSTM90_*_STMVDResamplerToCrystals",
      "keep mu2e::SimParticlemv_compressDetStepMCsSTM90_*_STMVDResamplerToCrystals",
      "keep mu2e::PhysicalVolumeInfomvs_*_*_*",
      "keep mu2e::StatusG4_*_*_*"
    ]
    SelectEvents : [STMVD90Path]
    fileName : "dts.owner.STMVDResamplerToVD90.version.sequencer.art"
  }
}

# Point Mu2eG4 at the GenParticles read in from the stage 1 art file. These start on the VD116
# surface, so this is a fresh single-stage G4 job rather than a resampled stage.
physics.producers.g4run.inputs : {
  primaryType : "GenParticles"
  primaryTag : "VDResamplerGenerator"
}
physics.producers.g4run.physics.physicsListName : "QGSP_BERT_EMZ" # as used in Offline/STMMC/fcl/Absorber.fcl
physics.producers.g4run.SDConfig.enableSD : [STMDet, virtualdetector]
physics.producers.g4run.Mu2eG4CommonCut : {}

# physics.producers.g4run.debug.trackingVerbosityLevel : 1
# physics.producers.g4run.debug.steppingVerbosityLevel : 1

services.SeedService.baseSeed : 8

# Epilog includes
#include "Production/JobConfig/common/MT.fcl"
#include "Production/JobConfig/common/epilog.fcl"
#include "Production/JobConfig/pileup/epilog.fcl"