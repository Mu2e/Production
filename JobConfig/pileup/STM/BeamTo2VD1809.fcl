# Propagate 1809 keV muon capture gammas to both VD101 and VD136 for STM studies
# Extends BeamToVD1809.fcl with a second virtual detector path
#include "Production/JobConfig/pileup/STM/BeamToVD1809.fcl"

process_name: BeamTo2VD1809

# Add VD136 extraction, compression, and filtering
physics.producers.extractVirtualDetectorSteps136 : {
  module_type : STMResamplingProducer
  StepPointMCsTag : @local::ResamplingProducer.StepPointMCsTag
  VirtualDetectorID : 136
}
physics.producers.compressDetStepMCsSTM136 : @local::physics.producers.compressDetStepMCsSTM
physics.producers.compressDetStepMCsSTM136.stepPointMCTags : ["extractVirtualDetectorSteps136"]

physics.filters.filterVirtualDetectorSteps136 : {
  module_type: STMResamplingFilter
  StepPointMCsTag : "compressDetStepMCsSTM136"
}

physics.analyzers.countVirtualDetectorHits.virtualDetectorIDs : [88, 89, 90, 100, 101, 116, 136]

# Add second trigger path
physics.PileupPath136 : [TargetStopResampler, @sequence::Common.generateSequence, @sequence::Common.g4Sequence, extractVirtualDetectorSteps136, compressDetStepMCsSTM136, filterVirtualDetectorSteps136]
physics.trigger_paths : [PileupPath, PileupPath136]

# Rename VD101 output to compressedOutput101 and add VD136 output
outputs.compressedOutput101 : @local::outputs.compressedOutput
outputs.compressedOutput101.SelectEvents : [PileupPath]
outputs.compressedOutput101.fileName : "dts.owner.BeamToVD101.version.sequencer.art"
outputs.compressedOutput136 : @local::outputs.compressedOutput
outputs.compressedOutput136.SelectEvents : [PileupPath136]
outputs.compressedOutput136.fileName : "dts.owner.BeamToVD136.version.sequencer.art"

physics.outPathCompressed : [genCountLogger, countVirtualDetectorHits, compressedOutput101, compressedOutput136]
