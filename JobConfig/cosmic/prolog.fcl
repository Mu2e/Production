#
#
#
BEGIN_PROLOG

crvOuterBox: {
  type: union
  pars:
  [
    # Upstream plane
    { type: plane normal: [  0, 0, -1 ] point : [ 0, 0, -3400 ] },
    # Downstream plane
    { type: plane normal: [  0, 0, 1 ] point : [ 0, 0, 19800 ] },
    # +x plane
    { type: plane normal: [  1, 0, 0 ] point : [ 1500, 0, 0 ] },
    # -x plane (outside of cryo box)
    { type: plane normal: [  -1, 0, 0 ] point : [ -8200, 0, 0 ] },
    # +y plane
    { type: plane normal: [  0, 1, 0 ] point : [ 0, 4000, 0 ] },
    # -y plane
    { type: plane normal: [  0, -1, 0 ] point : [ 0, -2100, 0 ] }
  ]
}

crvInnerBox: {
  type: intersection
  pars:
  [
    # Upstream plane
    { type: plane normal: [  0, 0, 1 ] point : [ 0, 0, -2200 ] },
    # Downstream plane
    { type: plane normal: [  0, 0, -1 ] point : [ 0, 0, 18500 ] },
    # +x plane
    { type: plane normal: [  -1, 0, 0 ] point : [ -1500, 0, 0 ] },
    # -x plane
    { type: plane normal: [  1, 0, 0 ] point : [ -6300, 0, 0 ] },
    # +y plane
    { type: plane normal: [  0, -1, 0 ] point : [ 0, 2500, 0 ] },
    # -y plane
    { type: plane normal: [  0, 1, 0 ] point : [ 0, -2100, 0 ] }
  ]
}

crvStage1End: {
  type: inVolume
  pars: [DSOuterCryoShell, DSInnerCryoShell, DSUpEndWallShell, TS5OuterCryoShell, TS5CryoInsVac, TS5Vacuum, Coll51, DS1Vacuum, DS2Vacuum, DS3Vacuum]
  write: crvStage1
}

cosmicKineticEnergyCutS1: {
  type: union
  pars:
  [
    {
      type: intersection
      pars:
      [
        { type: union pars: [ @local::crvOuterBox, @local::crvInnerBox ] },
        { type: kineticEnergy cut: 10.0 },
        { type: pdgId pars: [ 22, 2112 ] }
      ]
    },
    {
      # 5 MeV can only make a hit in 1 CRV layer
      type: intersection
      pars:
      [
        { type: union pars: [ @local::crvOuterBox, @local::crvInnerBox ] },
        { type: kineticEnergy cut: 5.0 },
        { type: pdgId pars: [ 2212, 11, -11 ] }
      ]
    }
  ]
}

cosmicKineticEnergyCutS2: {
  # Kill lower momentum particles outside of the CRV box
  type: intersection
  pars:
  [
    { type: intersection pars: [
        { type: kineticEnergy cut: 80.0 },
        { type: pdgId pars: [ 22, 11, -11, 2112 ] }]},
    { type: union pars: [ @local::crvOuterBox ] }
  ]
}

Cosmic: {
  CORSIKA : {
    source : {
      module_type: FromCorsikaBinary
      # example file only, should be overwritten downstream
      fileNames: ["/pnfs/mu2e/persistent/users/srsoleti/corsika/sim.srsoleti.corsika.v1.30001.csk"]
      runNumber          : 1205
      showerAreaExtension  : 10000
      projectToTargetBox : true
      targetBoxXmin: -10000
      targetBoxXmax: 3000
      targetBoxYmin: -5000
      targetBoxYmax: 5000
      targetBoxZmin: -5000
      targetBoxZmax: 21000
      fluxConstant: 1.8e4
    }
    generate: {
      module_type  : CORSIKAEventGenerator
      corsikaModuleLabel: "FromCorsikaBinary"
      refPointChoice: "UNDEFINED"
      projectToTargetBox : true
      targetBoxYmax : 5000
      intDist: -1
    }
  }
  # generator truncation filter; only needed for cosmic rays in principle
  g4status: {
    module_type: FilterStatusG4
    input: "g4run"
    maxAcceptedStatus: 9  #  status 10 and above means StepPointMCCollection may have non-dereferencable pointers
  }
  compressPV : {
    module_type: CompressPhysicalVolumes
    volumesInput : "g4run"
    hitInputs : []
    particleInputs : [ "cosmicFilter" ]
  }
  stepPointMomentumFilter: {
    module_type: FilterStepPointMomentum
    inputs : [ "g4run:crvStage1" ]
    cutMomentumMin: 0. # Filter all particles that hit DS region
  }
  S1LowFilter : {
    module_type: FilterCosmicsStage1
    inputs : [ "g4run:CRV" ]
    cutEDepMax: 16  # Filter events that deposit lower than 16 MeV in CRV
    DSStepPointMCs : "g4run:crvStage1" # only sum energy deposits earlier than the earliest DS entrance
  }
  cosmicFilter: {
  module_type: FilterG4Out
  mainHitInputs : [ "g4run:crvStage1", "g4run:CRV" ]
  extraHitInputs : []               #stores only StepPoints of tracks which also have StepPoints in the mainHitInputs
    mcTrajectoryInputs : [ "g4run" ]
    vetoDaughters: []
  }
  cosmicTimeOffset: {
    module_type: CosmicTimeOffset
    intervalStart: 0
    intervalEnd: 100005
  }
  # Stage-normalization counters. NOTE the cosmic S1 paths deliberately place
  # genCounter at the END, so that CosmicLivetime scales correctly after
  # resampling -- that GenEventCount is a post-filter count and would make
  # nGenEquivalent equal nPassed. A second GenEventCounter is not an option
  # either -- GenEventCounter refuses to write when another GenEventCount
  # exists in the SubRun. So cosmicGenCounter counts the generated events
  # itself (countAsGenerated), placed right after generate, and the stream
  # counters inherit from it. The existing genCounter/genCounterLow are left
  # exactly where they are and the livetime bookkeeping is untouched.
  # One line to enable stage normalization on S2, naming the S1 stream it
  # resamples. Not on by default -- see the note in pileup/prolog.fcl.
  StageNorm : {
    fromS1    : { moduleLabel : "s1Counter"    srOutInstance : "resampled" }
    fromS1Low : { moduleLabel : "s1LowCounter" srOutInstance : "resampled" }
  }

  cosmicGenCounter : {
    module_type : StageNormalizationCounter
    countAsGenerated : true
  }
  s1Counter : {
    module_type : StageNormalizationCounter
    upstreamTag : "cosmicGenCounter"
  }
  s1LowCounter : {
    module_type : StageNormalizationCounter
    upstreamTag : "cosmicGenCounter"
  }
  # S2 resamples an S1 stream, so its counter takes what the mixer carried
  # through rather than this job's own generated count.
  s2Counter : {
    module_type : StageNormalizationCounter
    upstreamTag : "CosmicResampler:resampled"
      required    : false
  }

  CosmicResampler: {
    module_type: ResamplingMixer
    fileNames: @nil
    readMode: "sequential"
    wrapFiles: true
    mu2e: {
      writeEventIDs : true
      MaxEventsToSkip: 0
      products: {
        genParticleMixer: { mixingMap: [ [ "generate", "" ] ] }
        simParticleMixer: { mixingMap: [ [ "cosmicFilter", ""] ] }
        mcTrajectoryMixer:{ mixingMap: [ [ "cosmicFilter", ""] ] }
        stepPointMCMixer: { mixingMap: [ [ "cosmicFilter:crvStage1", ":" ], [ "cosmicFilter:CRV", ":" ] ] }
        volumeInfoMixer: {
          evtOutInstanceName: "eventlevel"
          srInput: "compressPV"
        }
        simTimeOffset : "cosmicTimeOffset"
        cosmicLivetimeMixer: {
          moduleLabel: "generate"
          genCounterLabel: "genCounter::Primary"
        }
      }
    }
  }
  generateCRY: {
    module_type: CRYEventGenerator
    inputFile    : "Offline/EventGenerator/defaultConfigs/defaultCRYconfig.txt"
  }
  Mu2eG4CommonCutCosmicS2:{
    type: union
    pars:
    [
      @local::cosmicKineticEnergyCutS2,
      {
        type: inVolume
        pars: [ worldDirtBottom ]
      }
    ]
  }
  S2Inputs: {
    primaryType: StepPoints
    primaryTag: "CosmicResampler:crvStage1"
    inputMCTrajectories: "CosmicResampler"
    simStageOverride: 1
    inputPhysVolumeMultiInfo: "CosmicResampler"
        updateEventLevelVolumeInfos : {
      input: "CosmicResampler:eventlevel"
      outInstance: "eventlevel"
    }
  }
  Mu2eG4CommonCutCosmicS1: {
    type: union
    pars:
    [
      @local::cosmicKineticEnergyCutS1,
      @local::crvStage1End,
      {
        type: inVolume
        pars: [ worldDirtBottom ]
      }
    ]
  }
  Mu2eG4CommonCutCosmicNoField: {
    type: inVolume
    pars: [ worldDirtBottom ]
  }

  S2KeptProducts : [
    "keep mu2e::CosmicLivetime_*_mixed_*",
    "keep mu2e::StepPointMCs_CosmicResampler_crvStage1_*"
  ]

  S1KeptProducts : [
    "keep art::TriggerResults_*_*_*",
    "keep mu2e::StatusG4_*_*_*",
    "keep mu2e::CosmicLivetime_*_*_*",
    "keep *_compressPV_*_*",
    "keep mu2e::GenParticles_*_*_*",
    "keep *_cosmicFilter_*_*",
    "keep mu2e::*FilterFraction_*_*_*"
  ]

}

# Geant4 secondary splitting in stage 2 (S2ResamplerSplit.fcl), and the splitter job that puts each
# split family in its own event (S2FamilySplit.fcl). The two must agree: Geant4 splits in G4 regions,
# the splitter finds the split particles by birth position.
#   DS2Vacuum: the tube r < 950 mm around the DS axis (x = -3904 mm), Mu2e z 4179-8339 mm; it holds the
#     TS downstream absorber and the outer proton absorber, where most cosmic muon knock-on electrons
#     that reach the tracker are made.
#   TrackerMother: r 376.9-850.1 mm, Mu2e z 8539.5-11810.5 mm (tracker_v7). Split by a smaller factor:
#     nearly every muon crossing the tracker makes a secondary above 80 MeV/c in its support rings
#     (r > 700 mm), so x100 would add about one family event per event; x10 keeps most of the gain.
#   Walls, split x10 (CosmicSplitWallFactor; x100 in the inner cryostat wall gave 0.63 extra family events
#   per event, x10 0.06, for little more gain). These regions exist only to be split; their 10 mm cut is
#   the default. About 11% of the reconstructed cosmic background starts in them: knock-on electrons born
#   in the material, and photons from it that convert in the stopping target or the absorbers.
#     DSInnerCryoShell     r 950-969.05,   z 3239-14139     inner cryostat wall (about 6%)
#     DSCryoVacuumRegion   r 969.05-1303,  z 3269-14109     cryostat vacuum with the coils, thermal
#                                                           shields and supports (19 volumes)
#     DSOuterCryoShell     r 1303-1328,    z 3239-14139     outer cryostat wall
#     TS5DownstreamEndwall r 296.35-793.45, z 4160-4179     downstream end of TS5, just upstream of DS2
#     Coll53               r 248-294,      z 4160.02-4178.98
#     Coll52               r 235-243,      z 2929-4178.98
#     TS5InnerCryoShell    r 248-267,      z 2929-4160
#     TS5DownstreamEndwall2 r 270.01-375,  z 4110-4160      second end-wall piece, inside the TS5 cryostat
#   Each cylinder matches its volume exactly (100,000 sampled points per region in the GDML geometry, no
#   point in one but not the other), except TS5DownstreamEndwall2: it is a cone (outer radius 321.7 to 375 mm
#   over its first 25 mm), and its cylinder also holds a wedge of the TS5 insulating vacuum, where nothing is
#   made.
# Muon knock-on electrons (muIoni) and bremsstrahlung (muBrems) are split by Geant4 secondary biasing.
# Pair production (muPairProd) makes two secondaries, which Geant4 biasing does not split; Mu2eG4
# physics.processCopies makes each pair-production interaction of a muon N times instead, with the same
# factors in the same regions.
# Muon decays in flight come from a second stage-2 stream (S2ResamplerSplitDecay.fcl, then
# S2FamilySplitDecay.fcl) in which every muon decays within CosmicSplitDecayWindow ns of proper time;
# the main stream drops those decays. Each stream is normalized to its own livetime and the two add. In
# the decay stream each decay in flight is made CosmicSplitDecayCopies times (processCopies, everywhere).
# Stage-1 e+-, gammas above CosmicSplitStage1MinMomentum (mostly made in the concrete above the DS by stage
# 1, where no stage-2 split reaches them) are written CosmicSplitStage1Copies times by StepPointMCCopier
# before Geant4, so each becomes that many independent primaries. An event with more than
# CosmicSplitStage1MaxCopied of them (a shower; 2.4% of these particles in a 644,000-event test) is not
# copied: its particles count at weight 1. Without the cap one shower brought 80-100 of them, 1,100-1,400
# families in one event.
CosmicSplitFactor : 100
CosmicSplitTrackerFactor : 10
CosmicSplitWallFactor : 10
CosmicSplitDecayWindow : 50
CosmicSplitDecayCopies : 10
CosmicSplitStage1Copies : 14
CosmicSplitStage1MinMomentum : 80.
CosmicSplitStage1MaxCopied : 30
CosmicSplit : {
  G4 : [
    { process : muIoni  regions : [ DS2Vacuum ]     factor : @local::CosmicSplitFactor },
    { process : muBrems regions : [ DS2Vacuum ]     factor : @local::CosmicSplitFactor },
    { process : muIoni  regions : [ TrackerMother ] factor : @local::CosmicSplitTrackerFactor },
    { process : muBrems regions : [ TrackerMother ] factor : @local::CosmicSplitTrackerFactor },
    { process : muIoni  regions : [ DSInnerCryoShell, DSCryoVacuumRegion, DSOuterCryoShell, TS5DownstreamEndwall, Coll53, Coll52, TS5InnerCryoShell, TS5DownstreamEndwall2 ] factor : @local::CosmicSplitWallFactor },
    { process : muBrems regions : [ DSInnerCryoShell, DSCryoVacuumRegion, DSOuterCryoShell, TS5DownstreamEndwall, Coll53, Coll52, TS5InnerCryoShell, TS5DownstreamEndwall2 ] factor : @local::CosmicSplitWallFactor }
  ]
  # Mu2eG4 physics.processCopies, main stream: muon pair production, as G4 above
  copies : [
    { process : muPairProd particles : [ "mu-", "mu+" ] regions : [ DS2Vacuum ]     factor : @local::CosmicSplitFactor },
    { process : muPairProd particles : [ "mu-", "mu+" ] regions : [ TrackerMother ] factor : @local::CosmicSplitTrackerFactor },
    { process : muPairProd particles : [ "mu-", "mu+" ] regions : [ DSInnerCryoShell, DSCryoVacuumRegion, DSOuterCryoShell, TS5DownstreamEndwall, Coll53, Coll52, TS5InnerCryoShell, TS5DownstreamEndwall2 ] factor : @local::CosmicSplitWallFactor }
  ]
  # added in the decay stream: every muon decay in flight, everywhere (decays at rest are not copied)
  decayCopies : [
    { process : Decay particles : [ "mu-", "mu+" ] factor : @local::CosmicSplitDecayCopies }
  ]
  stage1Copier : {
    module_type : StepPointMCCopier
    input : "CosmicResampler:crvStage1"
    pdgIds : [ 11, -11, 22 ]
    minMomentum : @local::CosmicSplitStage1MinMomentum
    copies : @local::CosmicSplitStage1Copies
    maxCopied : @local::CosmicSplitStage1MaxCopied
  }
  # 10 mm everywhere except the DS vacuum regions (1 mm) and the calorimeter (0.1 mm). The tracker gets
  # 10 mm too (S2Resampler.fcl: 0.001 mm). Below the cut a delta ray is not made and its energy stays on
  # its parent's step, in the same straw; above it the soft kill removes it with its energy. So a larger
  # cut keeps more of the straw ionization and is faster: at 10 mm the electron threshold is 20 keV in the
  # straw gas (990 eV at 0.001-1 mm) and at most 29.5 MeV (tungsten), below the soft kill's 80 MeV; 30 mm
  # would reach 130 MeV in tungsten. Geant4 takes 0.89 of its time at 0.01 mm, and with 0.001 mm keV delta
  # rays in the tracker solids were made, split x10 and killed (about half of the Geant4 time). The mean
  # straw-hit energy of reconstructed electrons is still 7% below stock (delta rays above 20 keV).
  minRangeCut : 10.0
  regionCuts : { CalorimeterMother : 0.1 TrackerMother : 10.0 DS1Vacuum : 1.0 DS2Vacuum : 1.0 DS3Vacuum : 1.0
                 DSInnerCryoShell : 10.0 DSCryoVacuumRegion : 10.0 DSOuterCryoShell : 10.0
                 TS5DownstreamEndwall : 10.0 Coll53 : 10.0 Coll52 : 10.0 TS5InnerCryoShell : 10.0
                 TS5DownstreamEndwall2 : 10.0 }
  # Kill gammas, e+-, neutrons below 80 MeV (and everything in the dirt below the hall), except around the
  # calorimeter. Needed with splitting: otherwise every soft split copy is tracked and kept, and one event
  # can carry 1000+ split families. Mu2eG4CommonCut is applied at birth (stacking action) and at every step
  # (stepping action, the track's current energy), so it also kills an electron that slows below 80 MeV.
  # In the calorimeter that destroys the showers: with the kill everywhere, 6% of reconstructed split
  # electrons had a calorimeter cluster against 69% in stock, and calorimeter-based selections kept almost
  # nothing. So the kill applies only outside a regular octagonal prism around the calorimeter crystals:
  # Mu2e z 11842-13220 mm (calorimeter.caloMotherZ0/Z1), inner radius 800 mm about the DS axis (crystals
  # r < 719 mm), corners at 866 mm, inside the 950 mm bore. It must stay clear of the split cryostat-wall
  # regions: a square of half-width 950 mm reached them at its corners, where soft split copies then
  # survived as families (x1.6 per file). This costs x1.2 in CPU. A plane cut is true where
  # (x - point) . normal >= 0. The soft kill also removes soft particles that are not split (e.g. delta
  # rays in the straw gas above the tracker cut), so hit-level studies of those need S2Resampler.fcl.
  softKillCut : {
    type : union
    pars : [
      { type : intersection pars : [
          { type : kineticEnergy cut : 80.0 },
          { type : pdgId pars : [ 22, 11, -11, 2112 ] },
          { type : union pars : [
              { type : plane normal : [ 0, 0, -1 ] point : [ 0, 0, 11842 ] },
              { type : plane normal : [ 0, 0, 1 ] point : [ 0, 0, 13220 ] },
              { type : plane normal : [ 1, 0, 0 ] point : [ -3104, 0, 0 ] },
              { type : plane normal : [ 0.707107, 0.707107, 0 ] point : [ -3338.31, 565.69, 0 ] },
              { type : plane normal : [ 0, 1, 0 ] point : [ -3904, 800, 0 ] },
              { type : plane normal : [ -0.707107, 0.707107, 0 ] point : [ -4469.69, 565.69, 0 ] },
              { type : plane normal : [ -1, 0, 0 ] point : [ -4704, 0, 0 ] },
              { type : plane normal : [ -0.707107, -0.707107, 0 ] point : [ -4469.69, -565.69, 0 ] },
              { type : plane normal : [ 0, -1, 0 ] point : [ -3904, -800, 0 ] },
              { type : plane normal : [ 0.707107, -0.707107, 0 ] point : [ -3338.31, -565.69, 0 ] }
            ] }
        ] },
      { type : inVolume pars : [ worldDirtBottom ] }
    ]
  }
  splitter : {
    module_type : FamilySplitSource
    processes : [ "muIoni", "muBrems", "muPairProd" ]
    regions : [
      { xc : -3904. rmax : 950. zmin : 4179. zmax : 8339. factor : @local::CosmicSplitFactor },
      { xc : -3904. rmin : 376.9 rmax : 850.1 zmin : 8539.5 zmax : 11810.5 factor : @local::CosmicSplitTrackerFactor },
      { xc : -3904. rmin : 950. rmax : 969.05 zmin : 3239. zmax : 14139. factor : @local::CosmicSplitWallFactor },
      { xc : -3904. rmin : 969.05 rmax : 1303. zmin : 3269. zmax : 14109. factor : @local::CosmicSplitWallFactor },
      { xc : -3904. rmin : 1303. rmax : 1328. zmin : 3239. zmax : 14139. factor : @local::CosmicSplitWallFactor },
      { xc : -3904. rmin : 296.35 rmax : 793.45 zmin : 4160. zmax : 4179. factor : @local::CosmicSplitWallFactor },
      { xc : -3904. rmin : 248. rmax : 294. zmin : 4160.02 zmax : 4178.98 factor : @local::CosmicSplitWallFactor },
      { xc : -3904. rmin : 235. rmax : 243. zmin : 2929. zmax : 4178.98 factor : @local::CosmicSplitWallFactor },
      { xc : -3904. rmin : 248. rmax : 267. zmin : 2929. zmax : 4160. factor : @local::CosmicSplitWallFactor },
      { xc : -3904. rmin : 270.01 rmax : 375. zmin : 4110. zmax : 4160. factor : @local::CosmicSplitWallFactor }
    ]
    # output event number = input event number * stride + family index: at most stride - 1 families per input
    # event; 500,000 particles per job * 4000 = 2.0e9 still fits a signed 32-bit event number (EventNtuple)
    stride : 4000
    weightLabel : "FamilySplit"
    inputProcessName : "CosmicS2"
    muonDecayWindow : @local::CosmicSplitDecayWindow
    forcedDecayStream : false
    decayFactor : 0
    copiedPrimaries : {
      pdgIds : [ 11, -11, 22 ]
      minMomentum : @local::CosmicSplitStage1MinMomentum
      factor : @local::CosmicSplitStage1Copies
      copierLabel : "copyStage1"
    }
  }
}
# The CosmicSignal selection in stage 2 (S2ResamplerSplitSignal.fcl, S2ResamplerSplitSignalDecay.fcl) and in the
# FamilySplitSource job (S2FamilySplitSignal.fcl, S2FamilySplitSignalDecay.fcl).
# CosmicSplitCounter counts, for each SubRun, what FamilySplitSource needs for the stripped-event weight
# (events, those the muon-decay rule keeps, the sum of their family weights) before the selection, with the
# splitter's rules; FamilySplitSource then takes the weight from those counts (countsLabel).
# CosmicSplitSignalCut is the selection of SpillSplitter.fcl (SignalFilter): a particle of 30-250 MeV/c with at
# least 15 straw-gas steps spanning 16 planes. It is decided per particle, and every FamilySplitSource output event
# holds a subset of its input event's particles with all their steps, so the stage-2 events it drops give no output
# event that passes it. The FamilySplitSource job runs it again on each event it writes, so that its output is the
# CosmicSignal dataset and SpillSplitter.fcl is not run.
CosmicSplitCounter : {
  module_type : FamilySplitCounter
  simParticles : "compressDetStepMCs"
  processes : @local::CosmicSplit.splitter.processes
  regions : @local::CosmicSplit.splitter.regions
  muonDecayWindow : @local::CosmicSplit.splitter.muonDecayWindow
  forcedDecayStream : @local::CosmicSplit.splitter.forcedDecayStream
  decayFactor : @local::CosmicSplit.splitter.decayFactor
  copiedPrimaries : @local::CosmicSplit.splitter.copiedPrimaries
}
CosmicSplitSignalCut : {
  module_type : CosmicMixingFilter
  StrawGasSteps : "compressDetStepMCs"
  MinimumPartMom : 30
  MaximumPartMom : 250
  MinimumTrkSteps : 15
  MinimumTrkPlanes : 0
  MinimumTrkPlaneSpan : 16
  MaxImpact : 1000
}
END_PROLOG
