#
# Opt-in: record stage normalization on a primary stage resampling PION target
# stops (RPC and friends). Include AFTER primary/TargetPiStopParticle.fcl.
#
# Applied per stage rather than on the shared TargetPiStopResampler
# definition, so a stage whose pool predates the workflow is unaffected.
#
# The pool must carry "targetPiStopCounter", written by
# pileup/stageNormPiBeam.fcl. For a PiTargetStops sample predating this
# workflow, replace the block with the pool's stated poolGenCount and
# poolEventCount instead.
#
physics.filters.TargetPiStopResampler.mu2e.products.stageNormMixer : {
  moduleLabel   : "targetPiStopCounter"
  srOutInstance : "resampled"
}
physics.producers.primaryCounter : @local::Primary.producers.primaryPiStopCounter
physics.PrimaryPath : [ @sequence::physics.PrimaryPath, primaryCounter ]
