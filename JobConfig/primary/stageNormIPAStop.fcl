#
# Opt-in: record stage normalization on a primary stage resampling IPA muon
# stops. Include AFTER primary/IPAStopParticle.fcl.
#
# The pool must carry "IPAStopCounter", written by pileup/stageNormMuBeam.fcl
# (the IPA stop stream of the MuBeam pileup job). For a pool predating this
# workflow, state poolGenCount and poolEventCount instead.
#
physics.filters.IPAMuminusStopResampler.mu2e.products.stageNormMixer : {
  moduleLabel   : "IPAStopCounter"
  srOutInstance : "resampled"
}
physics.producers.primaryCounter : @local::Primary.producers.primaryIPAStopCounter
physics.PrimaryPath : [ @sequence::physics.PrimaryPath, primaryCounter ]
