#
# Base configuration for resampling target muon stops and generating primary particles from them
#
# original author: Dave Brown, LBNL
#
#include "Production/JobConfig/primary/StopParticle.fcl"

# primaryCounter closes the POT -> pileup -> primary chain: it reports what this
# output keeps against the normalization TargetStopResampler carried through.
# It is added HERE rather than to Primary.PrimarySequence because that sequence
# also serves primary stages resampling other pools (TargetPiStop,
# IPAMuminusStop, GammaConversion), none of which configure a stageNormMixer.
physics.PrimaryPath : [ TargetStopResampler, @sequence::Common.generateSequence, GenFilter, @sequence::Common.g4Sequence, @sequence::Primary.PrimarySequence, primaryCounter ]
physics.trigger_paths : [ PrimaryPath ]
outputs : { PrimaryOutput : @local::Primary.PrimaryOutput }
physics.EndPath : [ @sequence::Primary.EndSequence, PrimaryOutput ]
physics.end_paths : [ EndPath ]

physics.producers.g4run.inputs.inputPhysVolumeMultiInfo: "TargetStopResampler"
physics.producers.g4run.inputs.updateEventLevelVolumeInfos: {
  input: "TargetStopResampler:eventlevel"
  outInstance: "eventlevel"
}
