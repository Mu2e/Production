#
# Opt-in: record stage normalization on a primary stage resampling target
# stops. Include AFTER the primary FCL (e.g. primary/CeEndpoint.fcl).
#
# Also a resampling stage, so the normalization comes from the mixer rather
# than from this job's GenEventCount, which counts draws.
#
# Applied here rather than to the shared TargetStopResampler definition,
# which also serves MuStopPileup and other primaries whose pools may not
# carry the product.
#
# The pool must carry targetStopCounter, i.e. be built by MuBeamResampler with
# pileup/stageNormMuBeam.fcl. For a TargetStops sample predating this workflow,
# state the pool's totals instead:
#
#   physics.filters.TargetStopResampler.mu2e.products.stageNormMixer: {
#     poolGenCount    : <GenEventCount total over ALL of fileNames>
#     poolEventCount  : <events in ALL of fileNames>
#     srOutInstance   : "resampled"
#   }
#
physics.filters.TargetStopResampler.mu2e.products.stageNormMixer : {
  moduleLabel   : "targetStopCounter"
  srOutInstance : "resampled"
}

physics.producers.primaryCounter : @local::Primary.producers.primaryCounter
physics.PrimaryPath : [ @sequence::physics.PrimaryPath, primaryCounter ]
