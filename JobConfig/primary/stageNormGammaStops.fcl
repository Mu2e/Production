#
# Opt-in: record stage normalization on RMCGammaStops, which writes the gamma
# pools that the conversion stages resample.
# Include AFTER primary/RMCGammaStops.fcl.
#
# This job replaces trigger_paths with its own three, so the counters go on
# those rather than on PrimaryPath -- the PrimaryPath include would append to a
# path this job never schedules.
#
# It is a resampling stage (TargetStopResampler), so the counters take what the
# mixer carried through; set that up with primary/stageNormTargetStop.fcl,
# whose own primaryCounter is harmless here because PrimaryPath does not run.
#
physics.producers.targetGammaCounter : @local::Primary.producers.targetGammaCounter
physics.producers.wireGammaCounter   : @local::Primary.producers.wireGammaCounter
physics.producers.ipaGammaCounter    : @local::Primary.producers.ipaGammaCounter

physics.TargetPath : [ @sequence::physics.TargetPath, targetGammaCounter ]
physics.WirePath   : [ @sequence::physics.WirePath,   wireGammaCounter ]
physics.IPAPath    : [ @sequence::physics.IPAPath,    ipaGammaCounter ]
