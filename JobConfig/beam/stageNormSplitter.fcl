#
# Opt-in: record stage normalization on the beam splitter (POT -> MuBeamCat,
# EleBeamCat). Include AFTER BeamSplitter.fcl or MuBeamSplitter.fcl.
#
# A 1:1 filter stage: GenEventCount propagates from the POT file through
# RootInput, so genCountTag gives the generated count these events came from
# and nPassed becomes this stream's own count rather than the beam count.
# Without a counter here the split files carry POT's product, whose nPassed
# describes the beam stream and not them.
#
# The electron stream needs a PATH to be counted on, because a counter only
# runs on a path and electronout selected its events by RejectEvents. The
# negated filter selects exactly the same events ("not a muon"), so the
# output's contents are unchanged -- only how they are selected.
#
physics.producers.muonCounter     : { module_type : StageNormalizationCounter
                                      genCountTag : "genCounter" }
physics.producers.electronCounter : { module_type : StageNormalizationCounter
                                      genCountTag : "genCounter" }

physics.selectMuons     : [ @sequence::physics.selectMuons, muonCounter ]
physics.selectElectrons : [ "!muonSelector", electronCounter ]
physics.trigger_paths   : [ selectMuons, selectElectrons ]

outputs.electronout.RejectEvents : @erase
outputs.electronout.SelectEvents : [ selectElectrons ]
