#
# Opt-in: record stage normalization on the pion beam selector (Beam -> PiInfiniteBeamCat).
# Include AFTER beam/PionBeamSelector.fcl.
#
# Applied per stage rather than on the shared resampler definition: the same
# filter serves several stages against different pools, so the pool's counter
# label is a property of the STAGE, not of the resampler.
#
# The pool must carry "n/a (1:1 stage)". For a pool predating this workflow, replace the
# stageNormMixer block with the pool's stated totals:
#   poolGenCount : <GenEventCount total over fileNames>
#   poolEventCount : <events over fileNames>
#
# A 1:1 filter stage, so genCountTag is correct: GenEventCount propagates from
# the POT file and nPassed becomes the pion count.
physics.producers.pionCounter : { module_type : StageNormalizationCounter
                                  genCountTag : "genCounter" }
physics.selectPions : [ @sequence::physics.selectPions, pionCounter ]
